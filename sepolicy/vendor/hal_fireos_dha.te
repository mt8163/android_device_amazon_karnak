# SELinux policy for fireos.hardware.fireosdha@1.0-service
#
# FireOS DHA (Device Hardware Attestation) HAL server — HIDL service,
# user system, class hal.  Exposes DHA/attestation operations over hwbinder
# to the framework.

type hal_fireos_dha, domain;
type hal_fireos_dha_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(hal_fireos_dha)

# Register the HIDL interface with hwservicemanager
allow hal_fireos_dha hal_fireos_dha_hwservice:hwservice_manager { add find };
allow hal_fireos_dha hidl_base_hwservice:hwservice_manager add;

# hwbinder IPC
allow hal_fireos_dha hwbinder_device:chr_file rw_file_perms;
binder_use(hal_fireos_dha)

# TEE access for attestation operations
allow hal_fireos_dha tee_device:chr_file rw_file_perms;

# Read IDME identity from procfs
allow hal_fireos_dha proc:dir r_dir_perms;
allow hal_fireos_dha proc:file r_file_perms;
